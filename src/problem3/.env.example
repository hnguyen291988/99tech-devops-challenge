# Copy to .env for local overrides:  cp .env.example .env
#
# docker-compose.yml supplies a working default for every one of these, so the
# stack comes up with no .env at all. Nothing here is a real secret, and .env is
# gitignored so it stays that way.
#
# In a deployed environment these come from the platform's secret store
# (Secrets Manager / SSM Parameter Store / Vault) and are injected as container
# secrets, never committed and never baked into an image.

LISTEN_PORT=8080

# Consumed by the api AND substituted into the nginx upstream, so the two
# cannot disagree. This is the fix for the original :3001 vs :3000 mismatch.
API_HOST=api
API_PORT=3000

POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dev_only_not_a_secret

# Must satisfy: replicas x DB_POOL_MAX < postgres max_connections (60)
DB_POOL_MAX=10

NODE_VERSION=20-alpine
