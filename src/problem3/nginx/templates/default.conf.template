# Rendered to /etc/nginx/conf.d/default.conf at container start by the official
# image entrypoint, which runs envsubst over /etc/nginx/templates/*.template.
#
# ${API_HOST} and ${API_PORT} come from the environment, which is how the
# upstream address stays in lockstep with the app instead of being typed twice
# and drifting. NGINX runtime variables use the $name form (no braces), so
# envsubst leaves them alone.

# access_log and log_format are valid here: conf.d is included inside http{}.
log_format json_combined escape=json
  '{'
    '"time":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"request":"$request",'
    '"status":$status,'
    '"body_bytes":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"upstream_addr":"$upstream_addr",'
    '"upstream_status":"$upstream_status",'
    '"upstream_response_time":"$upstream_response_time",'
    '"request_id":"$request_id",'
    '"user_agent":"$http_user_agent"'
  '}';

access_log /dev/stdout json_combined;

upstream api_backend {
    server ${API_HOST}:${API_PORT} max_fails=3 fail_timeout=10s;

    # Without this, every proxied request opens and closes a TCP connection to
    # the upstream. Under load that burns CPU and eventually ephemeral ports.
    keepalive 32;
    keepalive_timeout 60s;
}

server {
    listen 80;
    server_name _;

    server_tokens off;
    add_header X-Request-Id $request_id always;

    # Cap request bodies at the edge instead of discovering the limit in the app.
    client_max_body_size 2m;
    client_body_timeout 10s;
    client_header_timeout 10s;

    # Proxy defaults, set once at server level so every location inherits them.
    proxy_http_version 1.1;          # required for upstream keepalive
    proxy_set_header Connection "";  # strip the hop-by-hop header, or keepalive is ignored
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id      $request_id;

    # Bounded, and short enough that a stuck upstream frees the worker.
    proxy_connect_timeout 2s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;

    # Retry the next attempt only on genuinely retryable failures. Deliberately
    # NOT including non_idempotent: silently replaying a POST is how you
    # double-charge someone.
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_next_upstream_tries 2;
    proxy_next_upstream_timeout 5s;

    location = / {
        default_type text/plain;
        return 200 "Welcome to the platform\n";
    }

    # nginx's own liveness. Deliberately does NOT touch the upstream: "is this
    # proxy alive" is a different question from "is the API healthy", and
    # conflating them makes both alarms useless.
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 "{\"status\":\"ok\",\"component\":\"nginx\"}\n";
    }

    # The API's readiness check, proxied so an external checker can reach it.
    # In the original config /status existed on the app but had no location
    # here, so nginx answered 404 out of its own static root.
    location = /readyz {
        access_log off;
        proxy_pass http://api_backend/readyz;
    }

    location /api/ {
        # No trailing slash on proxy_pass: the /api prefix is part of the
        # upstream's route table, so the URI passes through unchanged.
        proxy_pass http://api_backend;
    }

    location / {
        default_type text/plain;
        return 404 "Not found\n";
    }
}
